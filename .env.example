DATABASE_URL=postgresql://postgres:postgres@localhost:5432/falling_waters_portal
# Optional. Set to "require" for managed services that require TLS.
PGSSLMODE=
# Optional API port (default: 8787)
PORT=8787
# Optional comma-separated browser origins allowed to call API.
# Example: https://tbaggett1222.github.io
ALLOWED_ORIGINS=
# Alerting thresholds (used by GET /api/db/alert-status)
# Warn if last sync snapshot is older than this many minutes (default: 1440 = 24h)
ALERT_MAX_SYNC_AGE_MINUTES=1440
# Warn if database has fewer state key rows than this threshold (default: 1)
ALERT_MIN_STATE_KEYS=1
# Warn if database has fewer scope record rows than this threshold (default: 1)
ALERT_MIN_SCOPE_RECORDS=1
